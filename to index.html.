<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hand Connect</title>
<style>
  :root { --bg:#05060a; --panel:rgba(8,12,20,.72); --ink:#e8f1ff; --dim:#7f8da6; --ok:#5dffb0; }
  * { box-sizing:border-box; }
  html,body { margin:0; height:100%; background:var(--bg); color:var(--ink); font-family:"Trebuchet MS",system-ui,sans-serif; overflow:hidden; }
  #stage { position:fixed; inset:0; }
  video, canvas { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transform:scaleX(-1); }
  video { opacity:.55; filter:saturate(.8) brightness(.8); }
  #hud { position:fixed; top:12px; left:12px; background:var(--panel); border:1px solid rgba(255,255,255,.12); border-radius:8px; padding:10px 14px; font-size:13px; line-height:1.7; min-width:170px; backdrop-filter:blur(6px); }
  #hud b { color:var(--ok); font-weight:600; float:right; margin-left:16px; }
  #start { position:fixed; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; background:var(--bg); text-align:center; padding:24px; z-index:5; }
  #start h1 { font-size:clamp(28px,6vw,54px); margin:0; letter-spacing:.02em; background:linear-gradient(90deg,#ff4fd8,#ffe14f,#4ffff0); -webkit-background-clip:text; background-clip:text; color:transparent; }
  #start p { margin:0; color:var(--dim); max-width:42ch; }
  button { font:inherit; font-weight:600; padding:12px 28px; border-radius:999px; border:0; cursor:pointer; color:#05060a; background:linear-gradient(90deg,#ff4fd8,#ffe14f); }
  button:focus-visible { outline:3px solid #fff; outline-offset:3px; }
  #msg { color:#ff8a8a; min-height:1.2em; font-size:14px; }
</style>
</head>
<body>
<div id="stage">
  <video id="video" playsinline muted></video>
  <canvas id="fx"></canvas>
</div>
<div id="hud">Hands detected <b id="hHands">0</b><br>Gesture <b id="hGesture">None</b><br>Confidence <b id="hConf">0%</b></div>
<div id="start">
  <h1>Hand Connect</h1>
  <p>Hold up one or both hands to your webcam. Bring them together and apart to stretch a beam of light between them.</p>
  <button id="go">Start camera</button>
  <div id="msg"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1675469240/hands.js" crossorigin="anonymous"></script>
<script>
const video = document.getElementById('video');
const cv = document.getElementById('fx');
const ctx = cv.getContext('2d');
const $ = id => document.getElementById(id);
const COLORS = ['#ff4fd8', '#ffe14f', '#4ffff0', '#9d7bff'];
const BONES = [[0,1],[1,2],[2,3],[3,4],[0,5],[5,6],[6,7],[7,8],[5,9],[9,10],[10,11],[11,12],[9,13],[13,14],[14,15],[15,16],[13,17],[17,18],[18,19],[19,20],[0,17]];
let particles = [], hands = [], t = 0;

function resize() { cv.width = innerWidth; cv.height = innerHeight; }
addEventListener('resize', resize); resize();

// Map video coords to canvas, matching object-fit: cover
function mapPt(p) {
  const vw = video.videoWidth || 640, vh = video.videoHeight || 480;
  const s = Math.max(cv.width / vw, cv.height / vh);
  const ox = (cv.width - vw * s) / 2, oy = (cv.height - vh * s) / 2;
  return { x: p.x * vw * s + ox, y: p.y * vh * s + oy };
}

const d = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);

function gesture(lm) {
  const palm = d(lm[0], lm[9]);
  const ext = [[8,6],[12,10],[16,14],[20,18]].map(([tip, pip]) => d(lm[tip], lm[0]) > d(lm[pip], lm[0]) * 1.05);
  const n = ext.filter(Boolean).length;
  if (d(lm[4], lm[8]) < palm * 0.35) return 'Pinch';
  if (n === 0) return 'Fist';
  if (n === 4) return 'Open Hand';
  if (ext[0] && ext[1] && !ext[2] && !ext[3]) return 'Peace';
  if (ext[0] && n === 1) return 'Point';
  return n + ' fingers';
}

function glowLine(a, b, color, w) {
  ctx.lineCap = 'round';
  [[w * 5, .08], [w * 2.5, .25], [w, 1]].forEach(([lw, al], i) => {
    ctx.globalAlpha = al; ctx.strokeStyle = i === 2 ? '#fff' : color; ctx.lineWidth = lw;
    ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
  });
  ctx.globalAlpha = 1;
}

function spark(x, y, color) {
  for (let i = 0; i < 2; i++) {
    const a = Math.random() * Math.PI * 2, v = 1 + Math.random() * 3;
    particles.push({ x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, life: 1, color });
  }
}

function drawHand(lm, color) {
  const pts = lm.map(mapPt);
  ctx.shadowColor = color; ctx.shadowBlur = 18;
  BONES.forEach(([i, j]) => glowLine(pts[i], pts[j], color, 2.5));
  ctx.shadowBlur = 0;
  [4, 8, 12, 16, 20].forEach(i => {
    ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(pts[i].x, pts[i].y, 4, 0, 7); ctx.fill();
    if (Math.random() < .25) spark(pts[i].x, pts[i].y, color);
  });
  return pts;
}

function beam(a, b) {
  const len = d(a, b); if (len < 20) return;
  const g = ctx.createLinearGradient(a.x, a.y, b.x, b.y);
  ['#ff4fd8', '#ffe14f', '#5dffb0', '#4ffff0', '#9d7bff'].forEach((c, i, arr) => g.addColorStop(i / (arr.length - 1), c));
  const nx = -(b.y - a.y) / len, ny = (b.x - a.x) / len;
  ctx.globalCompositeOperation = 'lighter';
  for (let s = 0; s < 3; s++) {
    ctx.beginPath();
    for (let i = 0; i <= 40; i++) {
      const k = i / 40, wob = Math.sin(k * 12 + t * 8 + s * 2) * 6 * Math.sin(k * Math.PI) * (s ? 1 : .2);
      const x = a.x + (b.x - a.x) * k + nx * wob, y = a.y + (b.y - a.y) * k + ny * wob;
      i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
    }
    ctx.strokeStyle = g; ctx.lineWidth = s ? 2 : 6; ctx.globalAlpha = s ? .7 : .9;
    ctx.shadowColor = '#ffe14f'; ctx.shadowBlur = 25; ctx.stroke();
  }
  ctx.globalAlpha = 1; ctx.shadowBlur = 0; ctx.globalCompositeOperation = 'source-over';
  const k = Math.random();
  spark(a.x + (b.x - a.x) * k, a.y + (b.y - a.y) * k, '#ffe14f');
}

function frame() {
  t += 0.016;
  ctx.clearRect(0, 0, cv.width, cv.height);
  const tips = [];
  hands.forEach((lm, i) => {
    const pts = drawHand(lm, COLORS[i % COLORS.length]);
    tips.push({ x: (pts[4].x + pts[8].x) / 2, y: (pts[4].y + pts[8].y) / 2 });
  });
  if (tips.length >= 2) beam(tips[0], tips[1]);
  particles = particles.filter(p => p.life > 0);
  particles.forEach(p => {
    p.x += p.vx; p.y += p.vy; p.vy += .05; p.life -= .03;
    ctx.globalAlpha = Math.max(p.life, 0); ctx.fillStyle = p.color;
    ctx.fillRect(p.x, p.y, 3, 3);
  });
  ctx.globalAlpha = 1;
  requestAnimationFrame(frame);
}

async function start() {
  $('msg').textContent = '';
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ video: { width: 1280, height: 720, facingMode: 'user' } });
    video.srcObject = stream; await video.play();
  } catch (e) {
    $('msg').textContent = 'Camera blocked. Allow camera access in your browser and try again.'; return;
  }
  const mp = new Hands({ locateFile: f => `https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1675469240/${f}` });
  mp.setOptions({ maxNumHands: 2, modelComplexity: 1, minDetectionConfidence: .6, minTrackingConfidence: .5 });
  mp.onResults(r => {
    hands = r.multiHandLandmarks || [];
    $('hHands').textContent = hands.length;
    $('hGesture').textContent = hands.length ? gesture(hands[0]) : 'None';
    const sc = (r.multiHandedness || [])[0];
    $('hConf').textContent = sc ? Math.round(sc.score * 100) + '%' : '0%';
  });
  $('start').style.display = 'none';
  frame();
  const loop = async () => { if (video.readyState >= 2) await mp.send({ image: video }); requestAnimationFrame(loop); };
  loop();
}
$('go').addEventListener('click', start);
</script>
</body>
</html>
